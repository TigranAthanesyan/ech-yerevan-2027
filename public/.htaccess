# Apache (cPanel): send the bare root to the default locale.
# Permanent (301) since 2026-11-09. Browsers cache a 301, so use 302 again if the default language may change.
RewriteEngine On
RewriteRule ^$ /en/ [R=301,L]

# Unknown URLs outside /en/ and /hy/ get the bilingual 404 (the language folders override this).
ErrorDocument 404 /404.html
